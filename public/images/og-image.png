<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="ogBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0d14" />
      <stop offset="50%" stop-color="#0f1422" />
      <stop offset="100%" stop-color="#161c2d" />
    </linearGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#ogBg)" />
  <circle cx="1000" cy="150" r="300" fill="#38bdf8" opacity="0.05" />
  <circle cx="200" cy="500" r="250" fill="#818cf8" opacity="0.05" />
  
  <rect x="80" y="80" width="1040" height="470" rx="20" fill="#121826" stroke="rgba(255,255,255,0.08)" stroke-width="2" />
  
  <rect x="130" y="140" width="280" height="36" rx="18" fill="rgba(56,189,248,0.12)" stroke="rgba(56,189,248,0.3)" />
  <circle cx="150" cy="158" r="5" fill="#10b981" />
  <text x="165" y="163" fill="#38bdf8" font-family="monospace" font-size="14" font-weight="600">OPEN TO INTERNSHIPS</text>
  
  <text x="130" y="245" fill="#f8fafc" font-family="sans-serif" font-size="52" font-weight="bold">[YOUR FULL NAME]</text>
  <text x="130" y="305" fill="url(#textGrad)" font-family="sans-serif" font-size="30" font-weight="600">Software Engineering &amp; IT Undergraduate</text>
  
  <text x="130" y="370" fill="#94a3b8" font-family="sans-serif" font-size="20">Full-Stack Web • Mobile Applications • Cloud Architecture • REST APIs</text>
  
