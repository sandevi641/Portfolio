<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg1)" />
  
  <!-- Window Header -->
  <rect x="40" y="40" width="720" height="420" rx="12" fill="#131b2e" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" />
  <rect x="40" y="40" width="720" height="42" rx="12" fill="#0c111d" />
  <circle cx="65" cy="61" r="5" fill="#ef4444" />
  <circle cx="82" cy="61" r="5" fill="#f59e0b" />
  <circle cx="99" cy="61" r="5" fill="#10b981" />
  <text x="400" y="66" fill="#64748b" font-family="sans-serif" font-size="13" text-anchor="middle">Task &amp; Workflow Manager App</text>
  
  <!-- Kanban Mockup Columns -->
  <rect x="70" y="110" width="200" height="320" rx="8" fill="#182238" />
  <rect x="85" y="125" width="100" height="18" rx="4" fill="#38bdf8" opacity="0.3" />
  <rect x="85" y="160" width="170" height="65" rx="6" fill="#0e1524" stroke="rgba(56,189,248,0.3)" />
  <rect x="85" y="240" width="170" height="65" rx="6" fill="#0e1524" stroke="rgba(255,255,255,0.05)" />
  
  <rect x="300" y="110" width="200" height="320" rx="8" fill="#182238" />
  <rect x="315" y="125" width="100" height="18" rx="4" fill="#818cf8" opacity="0.3" />
  <rect x="315" y="160" width="170" height="75" rx="6" fill="#0e1524" stroke="rgba(129,140,248,0.3)" />
  <rect x="315" y="250" width="170" height="55" rx="6" fill="#0e1524" stroke="rgba(255,255,255,0.05)" />
  
  <rect x="530" y="110" width="200" height="320" rx="8" fill="#182238" />
  <rect x="545" y="125" width="100" height="18" rx="4" fill="#10b981" opacity="0.3" />
  <rect x="545" y="160" width="170" height="60" rx="6" fill="#0e1524" stroke="rgba(16,185,129,0.3)" />
</svg>
