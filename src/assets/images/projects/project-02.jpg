<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bg2)" />
  
  <!-- Mobile Phone Mockup Frame -->
  <rect x="280" y="30" width="240" height="440" rx="28" fill="#0f172a" stroke="#818cf8" stroke-width="2.5" />
  <rect x="350" y="45" width="100" height="15" rx="7.5" fill="#1e293b" />
  
  <!-- App Screen UI -->
  <rect x="296" y="75" width="208" height="40" rx="8" fill="#312e81" />
  <text x="320" y="100" fill="#c7d2fe" font-family="sans-serif" font-size="12" font-weight="bold">Campus Dining Menu</text>
  
  <rect x="296" y="130" width="208" height="60" rx="8" fill="#1e1b4b" stroke="rgba(255,255,255,0.08)" />
  <circle cx="325" cy="160" r="16" fill="#4f46e5" />
  <rect x="350" y="150" width="90" height="8" rx="4" fill="#e0e7ff" />
  <rect x="350" y="165" width="60" height="6" rx="3" fill="#818cf8" />
  
  <rect x="296" y="205" width="208" height="60" rx="8" fill="#1e1b4b" stroke="rgba(255,255,255,0.08)" />
  <circle cx="325" cy="235" r="16" fill="#06b6d4" />
  <rect x="350" y="225" width="90" height="8" rx="4" fill="#e0e7ff" />
  <rect x="350" y="240" width="60" height="6" rx="3" fill="#38bdf8" />
  
  <rect x="296" y="280" width="208" height="90" rx="8" fill="#0c0a09" stroke="#10b981" stroke-width="1" />
  <text x="400" y="325" fill="#34d399" font-family="monospace" font-size="11" text-anchor="middle">Order Status: READY</text>
  <text x="400" y="345" fill="#94a3b8" font-family="sans-serif" font-size="10" text-anchor="middle">Scan QR at counter</text>
</svg>
