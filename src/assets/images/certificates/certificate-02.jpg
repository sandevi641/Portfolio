<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 480" width="100%" height="100%">
  <defs>
    <linearGradient id="certBg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b132b" />
      <stop offset="100%" stop-color="#1c2541" />
    </linearGradient>
    <linearGradient id="awsGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ff9900" />
      <stop offset="100%" stop-color="#ffb703" />
    </linearGradient>
  </defs>
  <rect width="700" height="480" fill="url(#certBg2)" />
  <rect x="25" y="25" width="650" height="430" rx="8" fill="#131b2e" stroke="url(#awsGrad)" stroke-width="2" />
  <rect x="35" y="35" width="630" height="410" rx="6" fill="none" stroke="rgba(255,153,0,0.3)" stroke-width="1" stroke-dasharray="6 4" />
  
  <text x="350" y="90" fill="#ff9900" font-family="sans-serif" font-size="14" font-weight="bold" letter-spacing="3" text-anchor="middle">CLOUD CERTIFICATION</text>
  <text x="350" y="140" fill="#f8fafc" font-family="sans-serif" font-size="22" font-weight="bold" text-anchor="middle">AWS Certified Cloud Practitioner</text>
  <text x="350" y="180" fill="#94a3b8" font-family="sans-serif" font-size="13" text-anchor="middle">Successfully Awarded to</text>
  <text x="350" y="220" fill="#38bdf8" font-family="sans-serif" font-size="24" font-weight="bold" text-anchor="middle">[YOUR FULL NAME]</text>
  
  <text x="350" y="270" fill="#cbd5e1" font-family="sans-serif" font-size="12" text-anchor="middle">Demonstrating comprehensive knowledge of AWS Cloud Infrastructure &amp; Security.</text>
  
  <!-- Ribbon Badge -->
  <circle cx="350" cy="350" r="32" fill="url(#awsGrad)" />
  <text x="350" y="356" fill="#0f172a" font-family="sans-serif" font-size="11" font-weight="bold" text-anchor="middle">AWS</text>
  <text x="350" y="415" fill="#64748b" font-family="monospace" font-size="11" text-anchor="middle">Credential ID: AWS-CCP-847291</text>
</svg>
