<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 480" width="100%" height="100%">
  <defs>
    <linearGradient id="certBg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
  </defs>
  <rect width="700" height="480" fill="url(#certBg1)" />
  <rect x="25" y="25" width="650" height="430" rx="8" fill="#131b2e" stroke="url(#goldGrad)" stroke-width="2" />
  <rect x="35" y="35" width="630" height="410" rx="6" fill="none" stroke="rgba(245,158,11,0.3)" stroke-width="1" stroke-dasharray="6 4" />
  
  <text x="350" y="90" fill="#f59e0b" font-family="sans-serif" font-size="14" font-weight="bold" letter-spacing="3" text-anchor="middle">CERTIFICATE OF ACHIEVEMENT</text>
  <text x="350" y="140" fill="#f8fafc" font-family="sans-serif" font-size="22" font-weight="bold" text-anchor="middle">Meta Front-End Developer Professional</text>
  <text x="350" y="180" fill="#94a3b8" font-family="sans-serif" font-size="13" text-anchor="middle">Awarded to</text>
  <text x="350" y="220" fill="#38bdf8" font-family="sans-serif" font-size="24" font-weight="bold" text-anchor="middle">[YOUR FULL NAME]</text>
  
  <text x="350" y="270" fill="#cbd5e1" font-family="sans-serif" font-size="12" text-anchor="middle">Demonstrating advanced proficiency in React.js, modern UI/UX, and Web Architecture.</text>
  
  <!-- Ribbon Badge -->
  <circle cx="350" cy="350" r="32" fill="url(#goldGrad)" />
  <text x="350" y="356" fill="#0f172a" font-family="sans-serif" font-size="11" font-weight="bold" text-anchor="middle">VERIFIED</text>
  <text x="350" y="415" fill="#64748b" font-family="monospace" font-size="11" text-anchor="middle">Credential ID: META-FE-998241</text>
</svg>
